# ─── Public URL (used in email/Telegram links) ───
FIXITFELIX_PUBLIC_URL=https://your-app.vercel.app

# ─── Email notifications (Resend) ───
RESEND_API_KEY=re_...
FIXITFELIX_FROM_EMAIL=FixitFelix <notifications@your-verified-domain.com>
FIXITFELIX_NOTIFY_TO=technician@example.com
FIXITFELIX_EMAIL_ENABLED=true

# ─── Telegram notifications (Bot API) ───
FIXITFELIX_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# ─── AI photo verification (Google Gemini) ───
GEMINI_API_KEY=...
FIXITFELIX_VISION_MODEL=gemini-2.5-flash
FIXITFELIX_VISION_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash
FIXITFELIX_VERIFICATION_CONFIDENCE=0.7

# ─── Supabase database ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
