# Fix It Felix - Configuration Template
# Copy this file to .env and fill in your credentials.
# Do not commit .env with real secrets.

# --- AI Provider ---
# Get from https://aistudio.google.com/apikey
# Uses x-goog-api-key header for AQ. prefix auth keys
GEMINI_API_KEY=

# --- Telegram Bot ---
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# --- Technician Telegram Chat ID ---
# Auto-detected when someone first messages the bot.
# To find manually: message the bot, then check console output.
TECHNICIAN_CHAT_ID=

# --- API Server ---
API_PORT=3001

# --- Business Settings ---
SERVICE_AREA=Klang Valley, Malaysia
WORKING_HOURS=8AM - 8PM daily
BASE_RATE=RM 50 callout fee + RM 30/hour
SERVICES=plumbing, electrical, AC repair, general handyman
